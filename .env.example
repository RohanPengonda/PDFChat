# Google Gemini API key - required for chat functionality
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Set to "true" to disable Vite HMR
# DISABLE_HMR=true

# Optional: Shared token for API auth. If unset, all requests are allowed (dev-only).
# NOTE: the bundled UI does not send auth headers, so enabling this blocks the
# frontend until it is wired to forward the token. Not for production yet.
# AUTH_TOKEN=your_secret_token