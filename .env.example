# Google Gemini API key - required for chat functionality
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Set to "true" to disable Vite HMR
# DISABLE_HMR=true

# Optional: server bind address. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 to expose the API on the LAN / inside a container.
# HOST=0.0.0.0

# Optional: server port. Defaults to 3000.
# PORT=3000

# ── Authentication ───────────────────────────────────────────────────────────
# When set, every /api request (and the PDF viewer) must send this token as an
# "Authorization: Bearer <token>" header. The bundled UI shows a login screen.

# Single access token (backwards compatible). Its user id is the hash of the
# token, so all holders of this one token share one workspace.
# AUTH_TOKEN=your_secret_token

# Multiple tokens, each mapped to a distinct user id (true multi-user isolation).
# Format: <token>:<userId>,<token2>:<userId2>  (no spaces around the commas)
# AUTH_TOKENS=alice_token:alice,bob_token:bob

# Authentication is REQUIRED in production: if neither AUTH_TOKEN nor
# AUTH_TOKENS is set, `npm start` / NODE_ENV=production refuses to boot.